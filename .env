# ==============================
# CONFIGURACIÓN POSTGRES / PGADMIN
# ==============================

# Usuario principal de Postgres para conexión desde contenedor / host
POSTGRES_USER=admin2026            # Usuario administrador inicial de la base de datos
POSTGRES_PASSWORD=@dmin2026#       # Contraseña del usuario principal
POSTGRES_DB=auditdb                 # Base de datos principal que se creará

# Configuración de PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@auditoria2026.com   # Email de login para PgAdmin
PGADMIN_DEFAULT_PASSWORD=@dmin2026#            # Contraseña de login para PgAdmin

# ==============================
# USUARIOS DE AUDITDB
# ==============================

# 1. Usuario Administrador
POSTGRES_ADMIN_USER=admin_audit         # Usuario con permisos completos (CREATE, INSERT, UPDATE, DELETE, GRANT)
POSTGRES_ADMIN_PASSWORD=@dmin2026#      # Contraseña del usuario administrador

# 2. Usuario Solo Lectura
POSTGRES_READ_USER=lector_audit         # Usuario con permisos solo SELECT sobre todas las tablas
POSTGRES_READ_PASSWORD=lector2026!      # Contraseña del usuario de solo lectura

# 3. Usuario Operativo
POSTGRES_OPER_USER=operador_audit       # Usuario que puede SELECT, INSERT y UPDATE para procesos operativos
POSTGRES_OPER_PASSWORD=operador2026!    # Contraseña del usuario operativo

# 4. Usuario de Reportes
POSTGRES_REPORT_USER=reporte_audit      # Usuario con acceso SELECT a tablas específicas para reportes
POSTGRES_REPORT_PASSWORD=reporte2026!   # Contraseña del usuario de reportes

# 5. Usuario de Backup
POSTGRES_BACKUP_USER=backup_audit       # Usuario con permisos para respaldos y restauraciones
POSTGRES_BACKUP_PASSWORD=backup2026!    # Contraseña del usuario de backup

# 6. Usuario de Desarrollo
POSTGRES_DEV_USER=desarrollador_audit   # Usuario para desarrollo y pruebas de consultas
POSTGRES_DEV_PASSWORD=dev2026!          # Contraseña del usuario de desarrollo

# 7. Usuario Externo
POSTGRES_EXT_USER=externo_audit         # Usuario externo con permisos limitados, por ejemplo auditoría externa
POSTGRES_EXT_PASSWORD=externo2026!      # Contraseña del usuario externo

# 8. Usuario ETL
POSTGRES_ETL_USER=etl_audit             # Usuario para procesos de carga y extracción de datos
POSTGRES_ETL_PASSWORD=etl2026!          # Contraseña del usuario ETL

# 9. Usuario de Soporte
POSTGRES_SUPPORT_USER=soporte_audit     # Usuario para atención de tickets o soporte técnico
POSTGRES_SUPPORT_PASSWORD=soporte2026!  # Contraseña del usuario de soporte

# 10. Usuario Finanzas
POSTGRES_FIN_USER=finanzas_audit        # Usuario con permisos sobre compras y reportes financieros
POSTGRES_FIN_PASSWORD=finanzas2026!     # Contraseña del usuario de finanzas
